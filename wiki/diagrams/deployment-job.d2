vars: {
  canvas: "#F8FAFC"
  surface: "#FFFFFF"
  boundary-surface: "#F1F5F9"
  text: "#101828"
  muted: "#475467"
  border: "#CBD5E1"
  accent: "#0054A3"
  accent-surface: "#EFF6FF"
  warm: "#B54708"
  warm-surface: "#FFF7ED"
  d2-config: {theme-id: 0; layout-engine: elk; pad: 32; sketch: false}
}
style.fill: ${canvas}

classes: {
  title: {shape: text; style: {font-color: ${text}; font-size: 26; bold: true}}
  subtitle: {shape: text; style: {font-color: ${muted}; font-size: 15}}
  columns: {style: {fill: transparent; stroke: transparent}}
  boundary: {
    style: {
      fill: ${boundary-surface}
      stroke: ${border}
      font-color: ${text}
      font-size: 20
      stroke-width: 1
      border-radius: 8
    }
  }
  group: {
    style: {
      fill: ${surface}
      stroke: ${border}
      font-color: ${muted}
      font-size: 16
      stroke-width: 1
      border-radius: 8
    }
  }
  card: {
    width: 250
    style: {
      fill: ${surface}
      stroke: ${border}
      font-color: ${text}
      font-size: 15
      stroke-width: 1
      border-radius: 8
    }
  }
  card-2: {width: 505}
  card-3: {width: 330}
  emphasis: {style: {fill: ${accent-surface}; stroke: ${accent}; stroke-width: 2}}
  exception: {style: {fill: ${warm-surface}; stroke: ${warm}; stroke-width: 2}}
  ghost: {style: {fill: transparent; stroke: ${muted}; stroke-dash: 5; font-color: ${muted}}}
  caption: {shape: text; style: {font-color: ${muted}; font-size: 15}}
  link: {style: {stroke: ${muted}; stroke-width: 2; font-color: ${muted}; font-size: 14}}
  link-emphasis: {style: {stroke: ${accent}; stroke-width: 2; font-color: ${muted}; font-size: 14}}
  link-exception: {style: {stroke: ${warm}; stroke-width: 2; font-color: ${muted}; font-size: 14}}
  link-planned: {style: {stroke: ${muted}; stroke-width: 2; stroke-dash: 5; font-color: ${muted}; font-size: 14}}
}



page: "" {
  class: columns
  grid-columns: 1
  grid-gap: 10
  title_row: "" {
    class: columns
    grid-columns: 3
    grid-gap: 0
    pad_left: "." {shape: text; width: 290; style.opacity: 0}
    title: "Per-app Compare and Install Steps" {class: title}
    pad_right: "." {shape: text; width: 290; style.opacity: 0}
  }
  vertical-gap: 24

  first: "" {
    class: columns
    direction: right
    package: "Compare job: check feed\nand download package" {class: card; width: 245}
    tools: "Install diff tools\nand set up ACS CLI" {class: card; width: 245}
    export: "Check status and\nexport installed app" {class: card; width: 245}
    compare: "Run four compare\nsteps" {class: card; width: 245}
    artifact: "Publish attempt\ncompare artifact" {class: card; width: 245}
    package -> tools: {class: link}
    tools -> export: {class: link}
    export -> compare: {class: link}
    compare -> artifact: {class: link}
  }
  second: "" {
    class: columns
    direction: right
    package: "Install job: check feed\nand download package" {class: card; width: 245}
    setup: "Set up ACS CLI and\ncheck stack status" {class: card; width: 245}
    uninstall: "Optional uninstall\nof app and local settings" {class: card; width: 245}
    install: "Install package\nvia ACS" {class: [card; emphasis]; width: 245}
    verify: "Wait for version\nand check status" {class: card; width: 245}
    package -> setup: {class: link}
    setup -> uninstall: {class: link}
    uninstall -> install: {class: link-emphasis}
    install -> verify: {class: link}
  }
  first.artifact -> second.package: "after compare and approval" {class: link-exception}
}
