vars: {
  canvas: "#F8FAFC"
  surface: "#FFFFFF"
  boundary-surface: "#F1F5F9"
  text: "#101828"
  muted: "#475467"
  border: "#CBD5E1"
  accent: "#0054A3"
  accent-surface: "#EFF6FF"
  warm: "#B54708"
  warm-surface: "#FFF7ED"
  d2-config: {theme-id: 0; layout-engine: elk; pad: 32; sketch: false}
}
style.fill: ${canvas}

classes: {
  title: {shape: text; style: {font-color: ${text}; font-size: 26; bold: true}}
  subtitle: {shape: text; style: {font-color: ${muted}; font-size: 15}}
  columns: {style: {fill: transparent; stroke: transparent}}
  boundary: {
    style: {
      fill: ${boundary-surface}
      stroke: ${border}
      font-color: ${text}
      font-size: 20
      stroke-width: 1
      border-radius: 8
    }
  }
  group: {
    style: {
      fill: ${surface}
      stroke: ${border}
      font-color: ${muted}
      font-size: 16
      stroke-width: 1
      border-radius: 8
    }
  }
  card: {
    width: 250
    style: {
      fill: ${surface}
      stroke: ${border}
      font-color: ${text}
      font-size: 15
      stroke-width: 1
      border-radius: 8
    }
  }
  card-2: {width: 505}
  card-3: {width: 330}
  emphasis: {style: {fill: ${accent-surface}; stroke: ${accent}; stroke-width: 2}}
  exception: {style: {fill: ${warm-surface}; stroke: ${warm}; stroke-width: 2}}
  ghost: {style: {fill: transparent; stroke: ${muted}; stroke-dash: 5; font-color: ${muted}}}
  caption: {shape: text; style: {font-color: ${muted}; font-size: 15}}
  link: {style: {stroke: ${muted}; stroke-width: 2; font-color: ${muted}; font-size: 14}}
  link-emphasis: {style: {stroke: ${accent}; stroke-width: 2; font-color: ${muted}; font-size: 14}}
  link-exception: {style: {stroke: ${warm}; stroke-width: 2; font-color: ${muted}; font-size: 14}}
  link-planned: {style: {stroke: ${muted}; stroke-width: 2; stroke-dash: 5; font-color: ${muted}; font-size: 14}}
}

title: "Build Stage" {class: title; near: top-center}

page: "" {
  class: columns
  grid-columns: 1
  grid-gap: 10

  stages: "" {
    class: columns
    direction: down
    vertical-gap: 24
    first: "" {
      class: columns
      direction: right
      build: "Build stage · show stage plan" {class: card; width: 320}
      bump: "Bump PR version + manifest · pull requests only" {class: card; width: 320}
      build -> bump: {class: link}
    }
    second: "" {
      class: columns
      direction: left
      package: "Package the app" {class: card; width: 320}
      dist: "Artifact: dist package" {class: card; width: 320}
      package -> dist: {class: link}
    }
    first.bump -> second.package: {class: link}
  }
}
