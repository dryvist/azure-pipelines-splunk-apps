vars: {
  canvas: "#F8FAFC"
  surface: "#FFFFFF"
  boundary-surface: "#F1F5F9"
  text: "#101828"
  muted: "#475467"
  border: "#CBD5E1"
  accent: "#0054A3"
  accent-surface: "#EFF6FF"
  warm: "#B54708"
  warm-surface: "#FFF7ED"
  d2-config: {theme-id: 0; layout-engine: elk; pad: 32; sketch: false}
}
style.fill: ${canvas}

classes: {
  title: {shape: text; style: {font-color: ${text}; font-size: 26; bold: true}}
  subtitle: {shape: text; style: {font-color: ${muted}; font-size: 15}}
  columns: {style: {fill: transparent; stroke: transparent}}
  boundary: {
    style: {
      fill: ${boundary-surface}
      stroke: ${border}
      font-color: ${text}
      font-size: 20
      stroke-width: 1
      border-radius: 8
    }
  }
  group: {
    style: {
      fill: ${surface}
      stroke: ${border}
      font-color: ${muted}
      font-size: 16
      stroke-width: 1
      border-radius: 8
    }
  }
  card: {
    width: 250
    style: {
      fill: ${surface}
      stroke: ${border}
      font-color: ${text}
      font-size: 15
      stroke-width: 1
      border-radius: 8
    }
  }
  card-2: {width: 505}
  card-3: {width: 330}
  emphasis: {style: {fill: ${accent-surface}; stroke: ${accent}; stroke-width: 2}}
  exception: {style: {fill: ${warm-surface}; stroke: ${warm}; stroke-width: 2}}
  ghost: {style: {fill: transparent; stroke: ${muted}; stroke-dash: 5; font-color: ${muted}}}
  caption: {shape: text; style: {font-color: ${muted}; font-size: 15}}
  link: {style: {stroke: ${muted}; stroke-width: 2; font-color: ${muted}; font-size: 14}}
  link-emphasis: {style: {stroke: ${accent}; stroke-width: 2; font-color: ${muted}; font-size: 14}}
  link-exception: {style: {stroke: ${warm}; stroke-width: 2; font-color: ${muted}; font-size: 14}}
  link-planned: {style: {stroke: ${muted}; stroke-width: 2; stroke-dash: 5; font-color: ${muted}; font-size: 14}}
}



page: "" {
  class: columns
  grid-columns: 1
  grid-gap: 12
  title_row: "" {
    class: columns
    grid-columns: 3
    grid-gap: 0
    pad_left: "." {shape: text; width: 402; style.opacity: 0}
    title: "Manual Deploy Pipeline" {class: title}
    pad_right: "." {shape: text; width: 402; style.opacity: 0}
  }
  subtitle_row: "" {
    class: columns
    grid-columns: 3
    grid-gap: 0
    pad_left: "." {shape: text; width: 408; style.opacity: 0}
    subtitle: "Select environment\nand app IDs; repeat per app; restart once" {class: subtitle}
    pad_right: "." {shape: text; width: 408; style.opacity: 0}
  }

  first: "" {
    class: columns
    direction: right
    selection: "Select environment\nand app IDs" {class: card; width: 190}
    download: "Each app: download\nlatest from feed" {class: card; width: 190}
    before: "Check status before deploy" {class: card; width: 190}
    export: "Export installed app" {class: card; width: 190}
    selection -> download: {class: link}
    download -> before: {class: link}
    before -> export: {class: link}
  }
  second: "" {
    class: columns
    direction: left
    install: "Install package via ACS" {class: [card; emphasis]; width: 270}
    publish: "Publish per-app diff" {class: card; width: 270}
    compare: "Compare with package" {class: card; width: 270}
    compare -> publish: {class: link}
    publish -> install: {class: link-emphasis}
  }
  third: "" {
    class: columns
    direction: right
    wait: "Wait for package version" {class: card; width: 190}
    after: "Check status after\napp deploy" {class: card; width: 190}
    restart: "Restart once after\nall apps pass" {class: [card; emphasis]; width: 190}
    final: "Check status after\nrestart" {class: card; width: 190}
    wait -> after: {class: link}
    after -> restart: {class: link-emphasis}
    restart -> final: {class: link}
  }
  first.export -> second.compare: {class: link}
  second.install -> third.wait: {class: link}


}
