vars: {
  canvas: "#F8FAFC"
  surface: "#FFFFFF"
  boundary-surface: "#F1F5F9"
  text: "#101828"
  muted: "#475467"
  border: "#CBD5E1"
  accent: "#0054A3"
  accent-surface: "#EFF6FF"
  warm: "#B54708"
  warm-surface: "#FFF7ED"
  d2-config: {theme-id: 0; layout-engine: elk; pad: 32; sketch: false}
}
style.fill: ${canvas}

classes: {
  title: {shape: text; style: {font-color: ${text}; font-size: 26; bold: true}}
  subtitle: {shape: text; style: {font-color: ${muted}; font-size: 15}}
  columns: {style: {fill: transparent; stroke: transparent}}
  boundary: {
    style: {
      fill: ${boundary-surface}
      stroke: ${border}
      font-color: ${text}
      font-size: 20
      stroke-width: 1
      border-radius: 8
    }
  }
  group: {
    style: {
      fill: ${surface}
      stroke: ${border}
      font-color: ${muted}
      font-size: 16
      stroke-width: 1
      border-radius: 8
    }
  }
  card: {
    width: 250
    style: {
      fill: ${surface}
      stroke: ${border}
      font-color: ${text}
      font-size: 15
      stroke-width: 1
      border-radius: 8
    }
  }
  card-2: {width: 505}
  card-3: {width: 330}
  emphasis: {style: {fill: ${accent-surface}; stroke: ${accent}; stroke-width: 2}}
  exception: {style: {fill: ${warm-surface}; stroke: ${warm}; stroke-width: 2}}
  ghost: {style: {fill: transparent; stroke: ${muted}; stroke-dash: 5; font-color: ${muted}}}
  caption: {shape: text; style: {font-color: ${muted}; font-size: 15}}
  link: {style: {stroke: ${muted}; stroke-width: 2; font-color: ${muted}; font-size: 14}}
  link-emphasis: {style: {stroke: ${accent}; stroke-width: 2; font-color: ${muted}; font-size: 14}}
  link-exception: {style: {stroke: ${warm}; stroke-width: 2; font-color: ${muted}; font-size: 14}}
  link-planned: {style: {stroke: ${muted}; stroke-width: 2; stroke-dash: 5; font-color: ${muted}; font-size: 14}}
}



page: "" {
  class: columns
  grid-columns: 1
  grid-gap: 12
  title_row: "" {
    class: columns
    grid-columns: 3
    grid-gap: 0
    pad_left: "." {shape: text; width: 402; style.opacity: 0}
    title: "Manual Deploy Pipeline" {class: title}
    pad_right: "." {shape: text; width: 402; style.opacity: 0}
  }
  subtitle_row: "" {
    class: columns
    grid-columns: 3
    grid-gap: 0
    pad_left: "." {shape: text; width: 360; style.opacity: 0}
    subtitle: "Each app: compare, approve, install;\none optional restart when selected" {class: subtitle}
    pad_right: "." {shape: text; width: 360; style.opacity: 0}
  }

  first: "" {
    class: columns
    direction: right
    selection: "Select environment\nand app IDs" {class: card; width: 190}
    compare: "Compare <app> with <environment>\nParallel jobs:\nCompare with <environment> (no install)\nCompare with itsi-<environment> (no install)" {class: card; width: 310}
    review: "Review the compare, then\napprove Deploy <app> to\n<environment>" {class: [card; exception]; width: 230}
    selection -> compare: {class: link}
    compare -> review: {class: link}
  }
  second: "" {
    class: columns
    direction: left
    install: "Install on <environment>:\noptional uninstall,\ninstall via ACS" {class: [card; emphasis]; width: 240}
    wait: "Wait for the version,\ncheck status" {class: card; width: 210}
    lock: "Exclusive lock:\none app installs\nat a time" {class: [card; ghost]; width: 210}
    install -> wait: {class: link}
  }
  third: "" {
    class: columns
    direction: right
    approve_restart: "Optional Restart stage\nwhen checked with\napp IDs" {class: [card; exception]; width: 210}
    restart: "Restart only if ACS\nreports it is required" {class: [card; emphasis]; width: 210}
    final: "Check status after\nrestart" {class: card; width: 210}
    approve_restart -> restart: {class: link}
    restart -> final: {class: link}
  }
  first.review -> second.install: {class: link-exception}
  second.wait -> third.approve_restart: {class: link}

}
