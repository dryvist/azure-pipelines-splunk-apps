vars: {
  canvas: "#F8FAFC"
  surface: "#FFFFFF"
  boundary-surface: "#F1F5F9"
  text: "#101828"
  muted: "#475467"
  border: "#CBD5E1"
  accent: "#0054A3"
  accent-surface: "#EFF6FF"
  warm: "#B54708"
  warm-surface: "#FFF7ED"
  d2-config: {theme-id: 0; layout-engine: elk; pad: 32; sketch: false}
}
style.fill: ${canvas}

classes: {
  title: {shape: text; style: {font-color: ${text}; font-size: 26; bold: true}}
  subtitle: {shape: text; style: {font-color: ${muted}; font-size: 15}}
  columns: {style: {fill: transparent; stroke: transparent}}
  boundary: {
    style: {
      fill: ${boundary-surface}
      stroke: ${border}
      font-color: ${text}
      font-size: 20
      stroke-width: 1
      border-radius: 8
    }
  }
  group: {
    style: {
      fill: ${surface}
      stroke: ${border}
      font-color: ${muted}
      font-size: 16
      stroke-width: 1
      border-radius: 8
    }
  }
  card: {
    width: 250
    style: {
      fill: ${surface}
      stroke: ${border}
      font-color: ${text}
      font-size: 15
      stroke-width: 1
      border-radius: 8
    }
  }
  card-2: {width: 505}
  card-3: {width: 330}
  emphasis: {style: {fill: ${accent-surface}; stroke: ${accent}; stroke-width: 2}}
  exception: {style: {fill: ${warm-surface}; stroke: ${warm}; stroke-width: 2}}
  ghost: {style: {fill: transparent; stroke: ${muted}; stroke-dash: 5; font-color: ${muted}}}
  caption: {shape: text; style: {font-color: ${muted}; font-size: 15}}
  link: {style: {stroke: ${muted}; stroke-width: 2; font-color: ${muted}; font-size: 14}}
  link-emphasis: {style: {stroke: ${accent}; stroke-width: 2; font-color: ${muted}; font-size: 14}}
  link-exception: {style: {stroke: ${warm}; stroke-width: 2; font-color: ${muted}; font-size: 14}}
  link-planned: {style: {stroke: ${muted}; stroke-width: 2; stroke-dash: 5; font-color: ${muted}; font-size: 14}}
}



page: "" {
  class: columns
  grid-columns: 1
  grid-gap: 16
  title_row: "" {
    class: columns
    grid-columns: 3
    grid-gap: 0
    pad_left: "." {shape: text; width: 237; style.opacity: 0}
    title: "Variable Group Use" {class: title}
    pad_right: "." {shape: text; width: 237; style.opacity: 0}
  }
  subtitle_row: "" {
    class: columns
    grid-columns: 3
    grid-gap: 0
    pad_left: "." {shape: text; width: 204; style.opacity: 0}
    subtitle: "Groups selected by pipeline and environment" {class: subtitle}
    pad_right: "." {shape: text; width: 204; style.opacity: 0}
  }

  app: "App pipeline" {
    class: boundary
    grid-columns: 3
    grid-gap: 16
    appinspect: "splunk-appinspect\nAppInspect + Nonprod" {class: card; width: 210}
    nonprod: "splunk-nonprod\nNonprod deployment" {class: card; width: 210}
    prod: "splunk-prod\nProddiff comparison" {class: card; width: 210}
  }

  manual: "Manual pipelines" {
    class: boundary
    grid-columns: 3
    grid-gap: 16
    deploy: "Deploy\nAppInspect group:\nsplunk-appinspect\nEnvironment group:\nsplunk-<environment>" {class: card; width: 210}
    restart: "Restart\nVariable group:\n<target>-<environment>" {class: card; width: 210}
    compare_smoke: "Compare + Smoke test\nCompare groups:\n<prefix>-<source>\n<prefix>-<target>\nSmoke AppInspect:\nsplunk-appinspect\nSmoke environment:\n<target>-<environment>" {class: card; width: 210}
  }
}
