vars: {
  canvas: "#F8FAFC"
  surface: "#FFFFFF"
  boundary-surface: "#F1F5F9"
  text: "#101828"
  muted: "#475467"
  border: "#CBD5E1"
  accent: "#0054A3"
  accent-surface: "#EFF6FF"
  warm: "#B54708"
  warm-surface: "#FFF7ED"
  d2-config: {theme-id: 0; layout-engine: elk; pad: 32; sketch: false}
}
style.fill: ${canvas}

classes: {
  title: {shape: text; style: {font-color: ${text}; font-size: 26; bold: true}}
  subtitle: {shape: text; style: {font-color: ${muted}; font-size: 15}}
  columns: {style: {fill: transparent; stroke: transparent}}
  boundary: {
    style: {
      fill: ${boundary-surface}
      stroke: ${border}
      font-color: ${text}
      font-size: 20
      stroke-width: 1
      border-radius: 8
    }
  }
  group: {
    style: {
      fill: ${surface}
      stroke: ${border}
      font-color: ${muted}
      font-size: 16
      stroke-width: 1
      border-radius: 8
    }
  }
  card: {
    width: 250
    style: {
      fill: ${surface}
      stroke: ${border}
      font-color: ${text}
      font-size: 15
      stroke-width: 1
      border-radius: 8
    }
  }
  card-2: {width: 505}
  card-3: {width: 330}
  emphasis: {style: {fill: ${accent-surface}; stroke: ${accent}; stroke-width: 2}}
  exception: {style: {fill: ${warm-surface}; stroke: ${warm}; stroke-width: 2}}
  ghost: {style: {fill: transparent; stroke: ${muted}; stroke-dash: 5; font-color: ${muted}}}
  caption: {shape: text; style: {font-color: ${muted}; font-size: 15}}
  link: {style: {stroke: ${muted}; stroke-width: 2; font-color: ${muted}; font-size: 14}}
  link-emphasis: {style: {stroke: ${accent}; stroke-width: 2; font-color: ${muted}; font-size: 14}}
  link-exception: {style: {stroke: ${warm}; stroke-width: 2; font-color: ${muted}; font-size: 14}}
  link-planned: {style: {stroke: ${muted}; stroke-width: 2; stroke-dash: 5; font-color: ${muted}; font-size: 14}}
}



page: "" {
  class: columns
  grid-columns: 1
  grid-gap: 10
  title_row: "" {
    class: columns
    grid-columns: 3
    grid-gap: 0
    pad_left: "." {shape: text; width: 308; style.opacity: 0}
    title: "Pull Request Run" {class: title}
    pad_right: "." {shape: text; width: 308; style.opacity: 0}
  }
  first: "" {
    class: columns
    direction: right
    policy: "01 · Pull request branch policy" {class: card; width: 320}
    build: "02 · Build stage" {class: card; width: 320}
    policy -> build: {class: link}
  }
  second: "" {
    class: columns
    direction: left
    nonprod: "04 · Nonprod stage" {class: card; width: 320}
    inspect: "03 · AppInspect stage" {class: card; width: 320}
    inspect -> nonprod: {class: link}
  }
  third: "" {
    class: columns
    direction: right
    proddiff: "05 · Proddiff stage" {class: [card; emphasis]; width: 320}
    release: "06 · Release stage" {class: [card; ghost]; width: 320}
    proddiff -> release: "main only" {class: link-planned}
  }
  fourth: "" {
    class: columns
    direction: left
    prod: "07 · Deploy to prod" {class: [card; ghost]; width: 320}
  }
  first.build -> second.inspect: {class: link}
  second.nonprod -> third.proddiff: {class: link-emphasis}
  third.release -> fourth.prod: "main only" {class: link-planned}

}
