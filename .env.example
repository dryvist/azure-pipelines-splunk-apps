# Set by Azure Pipelines; set by hand only to run release.py locally.
BUILD_REPOSITORY_NAME=<app-repo>
SYSTEM_PULLREQUEST_TARGETBRANCH=refs/heads/main
SYSTEM_PULLREQUEST_SOURCEBRANCH=refs/heads/<source-branch>
BUILD_SOURCEVERSIONMESSAGE=<commit-message>

# splunk.com account for AppInspect and private app install
# (variable group splunk-appinspect).
SPLUNK_USERNAME=<splunk-account-username>
SPLUNK_PASSWORD=<splunk-account-password>

# Splunk Cloud stack name and ACS token (variable group splunk-nonprod or
# splunk-prod). Azure Pipelines maps ACS_TOKEN to STACK_TOKEN for the ACS CLI.
SPLUNK_STACK=<stack>
STACK_TOKEN=<acs-token>
